# Set to the approved public marketing origin before deployment.
# Empty preserves the legacy origin; this repo does not change DNS/routing.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=https://app.nafs.tech
NEXT_PUBLIC_ERP_URL=https://app.nafs.tech
NEXT_PUBLIC_SIGN_IN_URL=https://app.nafs.tech/auth/sign-in
NEXT_PUBLIC_DEMO_URL=/#contact
NEXT_PUBLIC_CONTACT_EMAIL=hello@nafsos.com
# Set to 0 on preview/staging builds. Public settings are compiled at build time.
NEXT_PUBLIC_INDEXABLE=1
# Enable only after approving trial terms and the actual signup journey.
NEXT_PUBLIC_TRIAL_ENABLED=0

# Server-only. An empty webhook disables online acceptance, not the site.
# Receiver must acknowledge durable receipt and honor Idempotency-Key.
NAFS_LEAD_WEBHOOK_URL=
NAFS_LEAD_WEBHOOK_TOKEN=
EMAIL=
LICENSE_KEY=

# Existing optional Studio integration; disabled by default.
STUDIO_RENDERER_ENABLED=0
STUDIO_ORIGIN=http://localhost:3000
STUDIO_API_URL=
STUDIO_REVALIDATION_SECRET=

MARKETING_PORT=3119
IMAGE_TAG=local
