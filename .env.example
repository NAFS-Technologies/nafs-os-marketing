# Set this to the approved public marketing origin before deployment.
# Empty preserves the legacy origin; no DNS/cutover is performed by this repo.
NEXT_PUBLIC_SITE_URL=
NEXT_PUBLIC_APP_URL=https://app.nafs.tech
NEXT_PUBLIC_ERP_URL=https://app.nafs.tech
NEXT_PUBLIC_SIGN_IN_URL=https://app.nafs.tech/auth/sign-in
NEXT_PUBLIC_DEMO_URL=/#contact
NEXT_PUBLIC_CONTACT_EMAIL=hello@nafsos.com
# Use 0 on preview/staging builds. These settings are compiled at build time.
NEXT_PUBLIC_INDEXABLE=1
# Enable only after the trial offer and signup journey are approved.
NEXT_PUBLIC_TRIAL_ENABLED=0

# Server-only. An empty webhook disables online lead acceptance, not the site.
NAFS_LEAD_WEBHOOK_URL=
EMAIL=
LICENSE_KEY=

# Optional Studio delivery (server-only); disabled by default.
STUDIO_RENDERER_ENABLED=0
STUDIO_ORIGIN=http://localhost:3000
STUDIO_API_URL=
STUDIO_REVALIDATION_SECRET=

MARKETING_PORT=3119
IMAGE_TAG=local
